#!/usr/bin/env bash
#
# dp-state -- snapshot the USB-C DisplayPort path, for diffing a working state
# against a broken one.
#
# The Framework 13 (Core Ultra Series 3, xe) intermittently loses an external
# display over a USB-C hub: data keeps working, video does not, and only a
# reboot has recovered it so far. Upstream: omacom/omarchy#11864 and
# FrameworkComputer/SoftwareFirmwareIssueTracker.
#
# WHAT IS ACTUALLY DIAGNOSTIC. Nothing in the PD/Type-C layer, as far as is
# known. Only this, which is a restatement of the symptom rather than a cause:
#
#     /sys/class/drm/card0-DP-1/status            connected / disconnected
#
# An earlier version claimed port 3 VCONN (from `framework_tool --pdports`)
# tracked the fault. RETRACTED: that was confounded with cold-boot vs runtime
# renegotiation. A hibernate resume gives VCONN=On with a working display.
# VCONN is still captured below, but read it as "who negotiated last", not as
# a fault indicator.
#
# WHAT IS A RED HERRING. All of the following read identically in the working
# and broken states, so none of them is the fault:
#
#     ucsi_acpi USBC000:00: unknown error 256
#     ucsi_acpi USBC000:00: GET_CABLE_PROPERTY failed (-5)
#     ucsi_acpi USBC000:00: con3: failed to register partner alt modes (-5)
#     framework_tool --pdports -> port 3 "DP Alt Mode: UFP_D Connected, HPD High"
#     every /sys/class/typec/portN/portN.1  svid=ff01  active=yes
#
# The sysfs alt-mode "active" flag in particular is worthless here: port0 reads
# active=yes with no partner plugged in at all. It is set at registration and
# never updated. An earlier version of this script called it THE discriminator;
# it is not, and the capture that disproved it is in ~/reports.
#
# Two lines DO appear only when wedged, but as symptoms rather than causes:
#
#     ucsi_acpi USBC000:00: GET_PDOS failed (-70)          (-ECOMM)
#     ucsi_acpi USBC000:00: con4: failed to register partner alt modes (-5)
#
# UCSI connectors are 1-based, so con4 is port3 -- the hub. con3 is port2, the
# charger, and its identical error fires in every state.
#
# Usage:  dp-state [working|broken|<label>]
# Writes ~/reports/dp-state-<label>-<timestamp>.txt and prints the summary.

set -uo pipefail

label="${1:-snapshot}"
out_dir="$HOME/reports"
mkdir -p "$out_dir"
out="$out_dir/dp-state-$label-$(date +%Y%m%d-%H%M%S).txt"

# find -L on purpose: /sys/class/typec/port* are symlinks and a plain find
# walks straight past every alt mode underneath them.
alt_modes() {
  find -L /sys/class/typec -maxdepth 3 -name svid 2>/dev/null | sort | while read -r f; do
    local d; d="$(dirname "$f")"
    printf '%-34s svid=%s active=%s\n' "${d#/sys/class/typec/}" \
      "$(cat "$f" 2>/dev/null)" "$(cat "$d/active" 2>/dev/null)"
  done
}

{
  printf '### dp-state  label=%s  captured=%s\n' "$label" "$(date -Is)"
  printf '### kernel=%s\n\n' "$(uname -r)"

  echo "## local DisplayPort alt mode per port (NOT diagnostic -- see header)"
  for p in /sys/class/typec/port?; do
    n="$(basename "$p")"
    for am in "$p"/"$n".*; do
      [[ -r "$am/svid" ]] || continue
      [[ "$(cat "$am/svid")" == "ff01" ]] || continue
      printf '  %-10s DP alt mode active=%s\n' "$n" "$(cat "$am/active" 2>/dev/null)"
    done
  done

  echo; echo "## hyprland monitors"
  hyprctl monitors all 2>/dev/null | grep -E '^Monitor|disabled:|dpmsStatus' || echo "  (hyprctl unavailable)"

  echo; echo "## drm connectors"
  for c in /sys/class/drm/card*-*/; do
    printf '  %-26s status=%-13s enabled=%s\n' "$(basename "$c")" \
      "$(cat "$c/status" 2>/dev/null)" "$(cat "$c/enabled" 2>/dev/null)"
  done

  echo; echo "## typec ports"
  for p in /sys/class/typec/port?; do
    printf '  %s:\n' "$(basename "$p")"
    for a in data_role power_role port_type orientation vconn_source \
             usb_power_delivery_revision usb_typec_revision; do
      [[ -r "$p/$a" ]] && printf '    %-30s %s\n' "$a" "$(cat "$p/$a" 2>/dev/null)"
    done
    printf '    %-30s %s\n' "partner present" \
      "$([[ -d "${p}-partner" ]] && echo yes || echo no)"
  done

  echo; echo "## all alt modes (local and partner)"
  alt_modes | sed 's/^/  /'

  echo; echo "## partner alt modes (historically NONE, even when working)"
  ls -d /sys/class/typec/port*-partner/port*-partner.* 2>/dev/null | sed 's/^/  /' \
    || echo "  none registered"

  echo; echo "## usb tree"
  lsusb -t 2>/dev/null | sed 's/^/  /'

  echo; echo "## yubikey-style usb activity counter for the hub port (context only)"
  for d in /sys/bus/usb/devices/*/; do
    [[ -r "$d/product" ]] || continue
    case "$(cat "$d/product" 2>/dev/null)" in
      *Hub*|*hub*) printf '  %-14s %-28s urbnum=%s\n' "$(basename "$d")" \
        "$(cat "$d/product")" "$(cat "$d/urbnum" 2>/dev/null)" ;;
    esac
  done
} > "$out" 2>&1

# Root-only bits. Skipped rather than failed if there is no way to elevate --
# the unprivileged half above is still worth having on its own.
if command -v pkexec >/dev/null 2>&1; then
  pkexec bash -c '
    echo; echo "## framework_tool --pdports"
    framework_tool --pdports 2>&1 | sed "s/^/  /"
    echo; echo "## retimers"
    framework_tool --versions 2>&1 | grep -A3 -i retimer | sed "s/^/  /"
    echo; echo "## DP-1 DPCD-derived fields (read over AUX -- SBU pins)"
    for f in i915_dp_max_link_rate i915_dp_max_lane_count force \
             i915_dp_link_retrain_disabled i915_psr_status; do
      printf "  %-32s %s\n" "$f" \
        "$(cat "/sys/kernel/debug/dri/0/DP-1/$f" 2>&1 | head -1)"
    done

    echo; echo "## ucsi messages this boot"
    dmesg -T 2>/dev/null | grep -i ucsi | tail -20 | sed "s/^/  /"
    echo; echo "## xe / drm messages this boot"
    dmesg -T 2>/dev/null | grep -iE "xe |drm|hpd" | tail -15 | sed "s/^/  /"
  ' >> "$out" 2>&1 || echo "(privileged section skipped)" >> "$out"
fi

echo "saved: $out"
echo

# The verdict, from the only two fields that track the fault.
dp1="$(cat /sys/class/drm/card0-DP-1/status 2>/dev/null || echo unknown)"
vconn="$(awk '/USB-C Port 3:/ { p = 1 } p && /VCONN:/ { print $2; exit }' "$out")"
: "${vconn:=unknown}"

printf '  card0-DP-1 status : %s\n' "$dp1"
printf '  port 3 VCONN      : %s\n' "$vconn"
echo
case "$dp1" in
  connected)    echo "  => DRM sees a display. NOT proof of an image: while wedged, link"
                echo "     training passes at every stage and the monitor still shows nothing." ;;
  disconnected) echo "  => WEDGED. See docs/displayport-wedge.md for the runbook; reboot is the" 
                echo "     only recovery proven so far. VCONN above is NOT a fault indicator." ;;
  *)            echo "  => could not read DP-1 status" ;;
esac
