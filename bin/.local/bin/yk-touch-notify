#!/usr/bin/env bash
#
# yk-touch-notify -- desktop notification when the YubiKey is waiting for a touch.
#
# The key blinks when it wants a touch, which is no use if you are looking at
# the screen. A missed touch fails with the same message as a stale PIV session
# ("agent refused operation"), so it is also easy to misdiagnose.
#
# HOW IT KNOWS. There is no "touch pending" flag anywhere in sysfs, but the USB
# request counter is a clean proxy. Measured on this machine:
#
#     idle                 0 URBs/sec
#     pending touch      3-4 URBs/sec, sustained for as long as it waits
#     completed op       one short burst, then silent again
#
# While the card waits, the CCID layer keeps polling it, so the counter ticks
# steadily. The baseline is a true zero, so sustained activity means an
# operation is genuinely in flight -- and any operation still in flight after
# the grace period is one waiting on a human.
#
# That makes this work for everything, with no command wrapping: git push over
# SSH, plain ssh, `age -d`, ssh-add -s, anything that reaches the token.
#
# Re-resolves the device by vendor id on every cycle, so unplugging and
# replugging into a different port does not need a restart.

set -uo pipefail

VENDOR_ID=1050                 # Yubico
POLL_INTERVAL=${YK_POLL_INTERVAL:-0.5}
GRACE_SAMPLES=${YK_GRACE_SAMPLES:-4}   # 4 x 0.5s = ~2s before notifying
APP_NAME="YubiKey"
# media-flash is a USB stick, and it is present in Yaru (the theme in use) as
# well as Adwaita, so it resolves in both. An icon name that the theme does not
# carry renders as the missing-icon placeholder -- auth-fingerprint has zero
# files installed and showed up as pink and black squares.
ICON=${YK_ICON:-media-flash}
# Confirmation icon. object-select-symbolic is the only checkmark present in
# BOTH Yaru (the current icon theme) and Adwaita, and Omarchy themes switch the
# icon theme -- a name the theme lacks renders as the missing-icon placeholder.
# Yaru also has emblem-default (a green tick, better looking, Yaru-only) if you
# never change themes: YK_ICON_OK=emblem-default.
ICON_OK=${YK_ICON_OK:-object-select-symbolic}

# Sound played when the touch prompt appears. The notification server does not
# do this for us: quickshell's GetCapabilities returns
# persistence/body/body-markup/body-hyperlinks/actions/icon-static and no
# "sound", so the freedesktop sound-name hint is ignored outright.
#
# canberra-gtk-play takes a sound-theme NAME rather than a path, so it follows
# whatever sound theme is installed. Set YK_SOUND=none to stay silent.
#
# In the freedesktop theme (the one in use) window-attention is a SYMLINK to
# dialog-warning.oga, and so was dialog-error, the old miss sound -- the two
# outcomes this script distinguishes used to make the identical 0.5s noise.
# Fixed by moving the MISS sound off that file, not this one; see SOUND_MISS.
# Check any name with: readlink /usr/share/sounds/freedesktop/stereo/<name>.oga
#
# It is short enough (0.5s) that the Bluetooth wake described at
# start_sound_loop below can swallow it whole. That is deliberate and
# acceptable: the prompt now repeats, so losing the first beep costs a few
# seconds of a ~15s window rather than the whole notification.
#
# Real files in this theme, if you ever want a longer one:
# message-new-instant (1.03s), complete (1.09s), dialog-warning (0.5s),
# bell (0.14s), suspend-error, phone-incoming-call, alarm-clock-elapsed.
SOUND=${YK_SOUND:-window-attention}

# Playback gain in dB, passed to canberra-gtk-play -V. 0.0 is the theme's own
# level; positive amplifies. The default sink here is a Bluetooth headset
# sitting at 45% while the built-in speakers are muted, so the theme level
# alone is easy to miss. Set YK_SOUND_VOLUME=0.0 to leave it alone.
SOUND_VOLUME=${YK_SOUND_VOLUME:-6.0}

# Seconds between repeats while the key is still waiting. The key gives up
# after ~15s, so this is bounded at a handful of repeats. 0 disables repeating
# and restores the old play-once behaviour.
SOUND_REPEAT_SEC=${YK_SOUND_REPEAT_SEC:-3}

# Icon for a missed touch. dialog-warning-symbolic is in both Yaru and
# Adwaita; the non-symbolic dialog-warning is Yaru-only.
ICON_MISS=${YK_ICON_MISS:-dialog-warning-symbolic}

# The key gives up waiting after a fixed timeout -- measured at 15.1s on this
# YubiKey, with USB traffic running for essentially that whole window. So the
# two outcomes are distinguishable by how long the activity lasted:
#
#   touched      traffic stops EARLY, whenever the finger lands
#   timed out    traffic runs the full ~15s, then stops
#
# Anything past this threshold that then goes quiet was almost certainly a
# miss. Set a shade under the real timeout so a genuinely late touch is not
# mislabelled; the cost is that a touch in the last second reads as a miss.
MISS_SAMPLES=${YK_MISS_SAMPLES:-28}    # 28 x 0.5s = 14s

# Sound for a missed touch, distinct from the prompt so the two are tellable
# apart without looking. A soft descending two-tone, chosen by ear against the
# prompt ding -- the point is that a miss must not be mistakable for a prompt
# you still have time to answer.
#
# Not dialog-error, the old default: it is a symlink to dialog-warning.oga,
# which is what the prompt resolves to, so the two sounded identical and the
# distinction this function goes to the trouble of making was inaudible.
# Not suspend-error either -- real and distinct, but it reads as an alarm,
# which is the wrong register for "you missed it, just run the command again".
# YK_SOUND_MISS=none to stay silent.
SOUND_MISS=${YK_SOUND_MISS:-service-logout}

find_device() {
  local d p
  for d in /sys/bus/usb/devices/*/idVendor; do
    [[ -r $d ]] || continue
    [[ "$(<"$d")" == "$VENDOR_ID" ]] || continue
    p=${d%/idVendor}
    [[ -r "$p/urbnum" ]] || continue
    printf '%s\n' "$p"
    return 0
  done
  return 1
}

notify_id=""

have_player() { command -v canberra-gtk-play >/dev/null 2>&1; }

vol_args=()
[[ -n ${SOUND_VOLUME:-} && $SOUND_VOLUME != none ]] && vol_args=(-V "$SOUND_VOLUME")

# Backgrounded and detached: the poll loop must not wait on audio, and a
# missing player or a dead audio session must not take the daemon down.
play_sound() {
  local name=${1:-}
  [[ -n $name && $name != none ]] || return 0
  have_player || return 0
  ( canberra-gtk-play "${vol_args[@]}" -i "$name" >/dev/null 2>&1 & ) &
}

sound_pid=""

# Repeat the prompt sound while the key is waiting, rather than playing it
# once. Two measured reasons, both on this machine:
#
#   1. The default sink is a Bluetooth headset, and the A2DP transport is
#      released once the node goes idle -- `pw-cli info <id>` shows
#      api.bluez5.transport = "" while nothing is playing. The link has to be
#      re-acquired for the next sound, which costs on the order of a second,
#      so a short sample after a quiet period is frequently swallowed whole.
#      That is the "notification appeared but I never heard it" case.
#   2. A single beep is easy to miss if you happen to be looking away at that
#      moment, which is the entire scenario this script exists for.
#
# canberra-gtk-play BLOCKS for the duration (~1.2s measured), so the real gap
# between beeps is that plus SOUND_REPEAT_SEC. The key gives up after ~15s, so
# at the default this is about four repeats before the miss sound takes over.
start_sound_loop() {
  local name=${1:-}
  [[ -n $name && $name != none ]] || return 0
  have_player || return 0

  # Play once up front either way, so behaviour with repeating disabled is
  # exactly what it was before.
  if [[ $SOUND_REPEAT_SEC == 0 || $SOUND_REPEAT_SEC == none ]]; then
    play_sound "$name"
    return 0
  fi

  (
    while :; do
      canberra-gtk-play "${vol_args[@]}" -i "$name" >/dev/null 2>&1
      sleep "$SOUND_REPEAT_SEC"
    done
  ) &
  sound_pid=$!
}

stop_sound_loop() {
  [[ -n $sound_pid ]] || return 0
  # The subshell is either sleeping or blocked in canberra-gtk-play, and
  # killing only the subshell would leave that child to finish its sample
  # after the touch has already landed. Job control is off in a script, so the
  # subshell shares our process group and kill -PGID is not an option.
  # Collect the children BEFORE killing the loop, so it cannot spawn a
  # replacement between the two calls.
  local kids
  kids="$(pgrep -P "$sound_pid" 2>/dev/null)" || true
  kill "$sound_pid" 2>/dev/null || true
  [[ -n $kids ]] && kill $kids 2>/dev/null
  wait "$sound_pid" 2>/dev/null || true
  sound_pid=""
}

open_notification() {
  # -p prints the id so the notification can be dismissed the moment the touch
  # lands, rather than lingering after it is no longer true.
  notify_id="$(notify-send -p -u critical -a "$APP_NAME" -i "$ICON" -t 0 \
    "Touch your YubiKey" "An operation is waiting on the key." 2>/dev/null)" || notify_id=""
  start_sound_loop "$SOUND"
}

# Omarchy will not let a sender dismiss a visible toast, so this replaces it
# instead of closing it. Two things in its notification service combine:
#
#   durationFor()   urgency=critical returns 0, meaning the popup NEVER expires
#   closed signal   only drops an internal ref; it never removes the popup card
#
# So CloseNotification is received and does nothing visible, and the critical
# toast sits there until dismissed by hand. Replacing by id is handled properly
# -- an update runs removePopupsByOriginalId -- so the critical card is swapped
# for a low-urgency one, which Omarchy does expire (its floor is 5s).
#
# Net effect: sticky for as long as the key is actually waiting, then clears
# itself a few seconds after the touch lands. Nothing to dismiss by hand.
close_notification() {
  # Unconditional and first: the loop must stop even when there is no
  # notification id to clear, or a failed notify-send would leave it beeping.
  stop_sound_loop
  [[ -n $notify_id ]] || return 0
  # Called with no argument from the signal trap: the daemon is going away
  # while a prompt is up, and it has no idea how that wait ended. Clear the
  # card without claiming either outcome.
  if [[ -z ${1:-} ]]; then
    notify-send -r "$notify_id" -u low -a "$APP_NAME" -i "$ICON" -t 1 \
      "YubiKey" "Touch prompt dismissed" >/dev/null 2>&1 || true
    notify_id=""
    return 0
  fi

  if (( $1 >= MISS_SAMPLES )); then
    # Ran the full timeout and then stopped: the key gave up, the operation
    # failed, and the failure it produces is "agent refused operation" -- which
    # looks identical to a stale PIV session. Saying so here is the whole point.
    notify-send -r "$notify_id" -u normal -a "$APP_NAME" -i "$ICON_MISS" -t 8000 \
      "Touch missed" "The key timed out after ~15s. Run the command again." \
      >/dev/null 2>&1 || true
    play_sound "$SOUND_MISS"
  else
    notify-send -r "$notify_id" -u low -a "$APP_NAME" -i "$ICON_OK" -t 1 \
      "YubiKey" "Touch confirmed" >/dev/null 2>&1 || true
  fi
  notify_id=""
}

trap 'close_notification; exit 0' TERM INT

dev=""
last=""
active=0

while :; do
  if [[ -z $dev || ! -r "$dev/urbnum" ]]; then
    # Key unplugged or moved ports. Drop any stale notification and rescan.
    close_notification
    active=0
    last=""
    dev="$(find_device)" || { sleep 2; continue; }
  fi

  now="$(<"$dev/urbnum")" 2>/dev/null || { dev=""; continue; }

  if [[ -n $last && $now != "$last" ]]; then
    active=$((active + 1))
    if (( active == GRACE_SAMPLES )); then
      open_notification
    fi
  else
    # Counter stopped moving: the operation finished, one way or another.
    (( active >= GRACE_SAMPLES )) && close_notification "$active"
    active=0
  fi

  last="$now"
  sleep "$POLL_INTERVAL"
done
