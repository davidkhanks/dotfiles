{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.

  // ---------------------------------------------------------------------
  // Reset Network  (System > Reset Network)
  //
  // For the boots where nothing comes up -- no Wi-Fi, no Ethernet, and no
  // error anywhere, because the service never started rather than failed.
  // See bin/.local/bin/net-reset for the full explanation; the short version
  // is that a systemd ordering cycle lets systemd delete an arbitrary job at
  // boot, and dbus-broker or NetworkManager is sometimes the one it picks.
  //
  // Runs in a floating terminal so the diagnosis is visible and sudo has
  // somewhere to prompt.
  // ---------------------------------------------------------------------
  "system.network-reset": {
    "icon": "󰖩",
    "label": "Reset Network",
    "description": "Restart NetworkManager, clear rfkill, re-trigger NICs — wifi ethernet internet offline no connection",
    "aliases": ["network-reset", "net-reset", "wifi-reset", "fix-network"],
    "action": "omarchy-launch-floating-terminal-with-presentation 'net-reset'"
  },

  // ---------------------------------------------------------------------
  // Device Check  (System > Device Check)
  //
  // For "my webcam / headset doesn't show up in Slack". Lists cameras, audio
  // devices and USB devices, flags USB devices seen in the last week that are
  // missing now, and shows the kernel's USB errors. Read-only, no sudo. See
  // bin/.local/bin/device-check.
  // ---------------------------------------------------------------------
  "system.device-check": {
    "icon": "󰍹",
    "label": "Device Check",
    "description": "Cameras, microphones, speakers, USB devices, missing devices and USB errors — webcam headset not showing up hub",
    "aliases": ["device-check", "devices", "webcam-check", "usb-check"],
    "action": "omarchy-launch-floating-terminal-with-presentation 'device-check'"
  },

  // ---------------------------------------------------------------------
  // Compliance Check  (System > Compliance Check)
  //
  // SOC 2 endpoint evidence for a compliance platform that cannot monitor
  // this machine: Vanta's agent is Debian/Ubuntu only and even there detects
  // nothing on Linux beyond disk encryption. Reads each control from the
  // live system rather than from config files, so what it prints is what is
  // actually in force. Read-only, no sudo. See bin/.local/bin/compliance-check.
  //
  // Writes ~/reports/compliance-<host>-<timestamp>.txt and exits non-zero if
  // any control FAILs. Add --screenshot to the action if you want the PNG
  // that Vanta accepts as evidence captured on every run; left off here
  // because the common case is checking, not filing.
  //
  // Icon is U+F0565, Material Design shield-check -- same family as the
  // other System rows, and verified by rendering it from
  // JetBrainsMonoNerdFont-Regular.ttf rather than trusting the codepoint
  // name. Note the stock Setup > Security icon (U+EB11) is a KEY, not a
  // shield. Write icons as \uXXXX escapes, never as literal glyphs: a
  // literal pasted through a shell heredoc here arrived as an empty string
  // and the row rendered with no icon at all.
  // ---------------------------------------------------------------------
  "system.compliance-check": {
    "icon": "󰕥",
    "label": "Compliance Check",
    "description": "SOC 2 endpoint controls: disk encryption, screen lock, firewall, updates — security review audit evidence vanta",
    "aliases": ["compliance-check", "security-check", "security-review", "soc2", "audit"],
    "action": "omarchy-launch-floating-terminal-with-presentation 'compliance-check'"
  },

  // ---------------------------------------------------------------------
  // System menu order: Screensaver, Lock, Reset Network, Device Check,
  // Compliance Check, Suspend, Hibernate, Logout, Reboot, Shutdown.
  //
  // The menu has no order field: rows keep the position where they were
  // first defined, defaults first, and overriding an id doesn't move it. So
  // the stock rows after Lock are hidden ("when": "false") and redefined
  // below under new ids, which lands them after the two rows above. The
  // copies match /usr/share/omarchy/default/omarchy/omarchy-menu.jsonc as
  // of 2026-11-03; if a stock row changes upstream, update its copy here.
  // ---------------------------------------------------------------------
  "system.suspend": {"when": "false"},
  "system.hibernate": {"when": "false"},
  "system.logout": {"when": "false"},
  "system.reboot": {"when": "false"},
  "system.shutdown": {"when": "false"},

  "system.after-suspend": {"icon":"󰒲","label":"Suspend","when":"! omarchy-toggle-enabled suspend-off && ! omarchy-sleep-disabled","action":"systemctl suspend"},
  "system.after-hibernate": {"icon":"󰤁","label":"Hibernate","when":"omarchy-hibernation-available && ! omarchy-sleep-disabled","action":"systemctl hibernate"},
  "system.after-logout": {"icon":"󰍃","label":"Logout","action":"omarchy-system logout"},
  "system.after-reboot": {"icon":"󰜉","label":"Reboot","action":"omarchy-system reboot"},
  "system.after-shutdown": {"icon":"󰐥","label":"Shutdown","action":"omarchy-system shutdown"},

  // ---------------------------------------------------------------------
  // OTP  (root > OTP > Canvas)
  //
  // One-time codes generated by the YubiKey's OATH applet instead of a phone
  // authenticator. See bin/.local/bin/otp for why this exists: Canvas
  // has no passkey/WebAuthn support, so the TOTP seed lives on the key, and
  // OATH is not keyboard emulation -- touching the key authorises the
  // request, but something still has to ask over CCID and put the answer on
  // the clipboard.
  //
  // THIS ROW LANDS AT THE BOTTOM of the root menu, after System, and cannot
  // be moved up. Rows keep the position where they are first defined, the
  // stock menu is merged first, and a new user id is always appended --
  // mergeMenuSources only pushes an id the first time it sees it, and there
  // is no order/index field in the schema. The System submenu trick (hide
  // the stock row, redefine it under a new id) works for LEAF rows but not
  // here: redefining a SUBMENU row under a new id orphans its children,
  // which resolve by dotted prefix. Putting OTP second would mean mirroring
  // learn/appearance/trigger/setup/install/remove/update/about/system and
  // their 415 child rows.
  //
  // Icons verified by RENDERING them from JetBrainsMonoNerdFont-Regular.ttf
  // rather than trusting codepoint names: U+F0306 is a key (the codes come
  // from the YubiKey) and U+F1180 is a graduation cap (Canvas is an LMS).
  // Both sit above U+FFFF, so they cannot be written as 4-digit JSON \uXXXX
  // escapes at all; this block was generated with Python chr() so the
  // literal glyph lands in the file, as the System rows above were.
  //
  // No floating terminal here, unlike the System rows: otp prints
  // nothing to stdout and reports purely through notifications.
  //
  // ADDING A SERVICE IS ONE ROW AND NO CODE. `otp` takes the account as its
  // first argument and matches it against the stored "<issuer>:<name>", so a
  // new service means enrolling it on the key and adding a row here with
  // "action": "otp <Issuer>". The query must match exactly one account --
  // `ykman oath accounts code -s` requires a single match, and `otp --list`
  // shows what is on the key.
  // ---------------------------------------------------------------------
  "otp": {
    "icon": "󰌆",
    "label": "OTP",
    "description": "One-time codes from the YubiKey — 2fa mfa totp authenticator one time password",
    "aliases": ["otp", "totp", "2fa", "mfa", "auth", "authenticator"]
  },

  "otp.atlassian": {
    "icon": "󰠄",
    "label": "Atlassian",
    "description": "Copy an Atlassian MFA code to the clipboard — jira confluence bitbucket login sign in",
    "aliases": ["atlassian", "jira", "confluence", "trello"],
    "action": "otp Atlassian"
  },

  "otp.betterment": {
    "icon": "󱀇",
    "label": "Betterment",
    "description": "Copy a Betterment MFA code to the clipboard — retirement investing ira 401k brokerage",
    "aliases": ["betterment", "retirement", "investing", "ira", "401k", "brokerage"],
    "action": "otp Betterment"
  },

  "otp.bitbucket": {
    "icon": "󰂨",
    "label": "Bitbucket",
    "description": "Copy a Bitbucket MFA code to the clipboard — git repo pull request source code",
    "aliases": ["bitbucket", "git", "repo", "pr", "source"],
    "action": "otp BitBucket"
  },

  "otp.canvas": {
    "icon": "󱆀",
    "label": "Canvas",
    "description": "Copy a Canvas MFA code to the clipboard — lms instructure login sign in course",
    "aliases": ["canvas", "canvas-otp", "canvas-mfa", "instructure"],
    "action": "otp Canvas"
  },

  "otp.google": {
    "icon": "󰊭",
    "label": "Google",
    "description": "Copy a Google MFA code to the clipboard — gmail workspace account sign in",
    "aliases": ["google", "gmail", "workspace", "google-otp"],
    "action": "otp Google"
  },

  "otp.gusto": {
    "icon": "",
    "label": "Gusto",
    "description": "Copy a Gusto MFA code to the clipboard — payroll paycheck paystub w2 tax benefits",
    "aliases": ["gusto", "payroll", "paycheck", "paystub", "w2", "benefits"],
    "action": "otp Gusto"
  },
}
